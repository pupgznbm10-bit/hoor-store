# Copy this file to .env.local and fill in your Gmail account and app password (do NOT commit .env.local to source control)

# Gmail account used to send OTP emails
EMAIL_USER=your-email@gmail.com
# App password generated from Google Account > Security > App passwords (use a 16-character app password)
EMAIL_PASS=your-gmail-app-password

# Optional: JWT secret (recommended to override in production)
# JWT_SECRET=change-this-secret
